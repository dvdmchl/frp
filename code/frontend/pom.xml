<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.dreamabout.sw.frp</groupId>
        <artifactId>code</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>frontend</artifactId>
    <name>frp-frontend</name>
    <description>FRP - frontend</description>
    <packaging>pom</packaging>

    <properties>
        <frontend.maven.plugin.version>1.15.4</frontend.maven.plugin.version>
        <node.version>v24.12.0</node.version>
        <sonar.projectKey>frp-frontend</sonar.projectKey>
        <sonar.projectName>FRP Frontend</sonar.projectName>
        <sonar.sources>frp-fe/src</sonar.sources>
        <sonar.tests>frp-fe/src</sonar.tests>
        <sonar.exclusions>
            frp-fe/src/api/**,
            **/*.test.ts,
            **/*.test.tsx,
            **/*.stories.tsx
        </sonar.exclusions>
        <sonar.test.inclusions>
            **/*.test.ts,
            **/*.test.tsx
        </sonar.test.inclusions>
        <sonar.coverage.exclusions>
            frp-fe/src/test/**,
            frp-fe/src/main.tsx,
            **/*.d.ts
        </sonar.coverage.exclusions>
        <sonar.javascript.lcov.reportPaths>frp-fe/coverage/lcov.info</sonar.javascript.lcov.reportPaths>
        <!-- Tailwind CSS 4 directives (@source, @custom-variant, @theme) are not standard CSS at-rules -->
        <sonar.issue.ignore.multicriteria>tailwind</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.tailwind.ruleKey>css:S4662</sonar.issue.ignore.multicriteria.tailwind.ruleKey>
        <sonar.issue.ignore.multicriteria.tailwind.resourceKey>**/*.css</sonar.issue.ignore.multicriteria.tailwind.resourceKey>
        <sonar.typescript.tsconfigPaths>frp-fe/tsconfig.app.json,frp-fe/tsconfig.node.json</sonar.typescript.tsconfigPaths>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend.maven.plugin.version}</version>
                <configuration>
                    <workingDirectory>frp-fe</workingDirectory>
                    <nodeVersion>${node.version}</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>npm install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>npm build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>npm run test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run test</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>